# 9Router credentials — copy to .env and fill in. .env is gitignored.
#
# Read by the daemon at startup only. The daemon promotes these into the
# named LLM profile it keeps in the runtime state directory (~/.agentrt on
# Linux/macOS, %LOCALAPPDATA%\agentrt on Windows), so the key is never sent
# to Claude Code or Codex and never lands in a session workspace.
#
# Two endpoints because the routing decision (round 9) keeps each model on
# its native protocol: Claude models go through the Anthropic-compatible
# endpoint so thinking blocks and their signatures survive, everything else
# goes through the OpenAI-compatible one.

AGENTRT_9ROUTER_API_KEY=

AGENTRT_9ROUTER_OPENAI_BASE_URL=
AGENTRT_9ROUTER_ANTHROPIC_BASE_URL=

# Model ids as 9Router exposes them. Used as the default profile in P2.
AGENTRT_DEFAULT_MODEL=
AGENTRT_DEFAULT_ANTHROPIC_MODEL=
