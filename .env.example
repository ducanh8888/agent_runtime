# 9Router credentials — copy to .env and fill in. .env is gitignored.
#
# Read by the daemon at startup only. The daemon promotes these into the
# named LLM profile it keeps in the runtime state directory (~/.agentrt on
# Linux/macOS, %LOCALAPPDATA%\agentrt on Windows), so the key is never sent
# to Claude Code or Codex and never lands in a session workspace.
#
# One base URL, not two. The endpoint is compatible with both the OpenAI and
# the Anthropic protocol, and it serves no Anthropic models, so the split
# route from round 9 has nothing to route.

AGENTRT_9ROUTER_API_KEY=
AGENTRT_9ROUTER_BASE_URL=

# Model id as 9Router exposes it. Verified working: text and tool calls in
# both streaming and non-streaming mode, with usage reported. Do not use the
# `free-model` alias: it returns text only when streaming and tool calls only
# when not streaming, so no single mode serves an agent turn.
AGENTRT_DEFAULT_MODEL=ds/deepseek-v4-flash
