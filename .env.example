# Provider credentials for agentrt.
#
# WHERE THIS FILE GOES. agentrt reads configuration from, in order:
#
#   1. the process environment
#   2. <state-dir>/.env       <- the home for an installed copy
#   3. a .env beside this file, if you are working in a checkout
#
# The state directory is %LOCALAPPDATA%\agentrt on Windows and ~/.agentrt
# elsewhere; `agentrt config` prints the exact path. Prefer (2): it is the
# only location that does not assume a particular checkout exists, and it
# keeps the credential out of any repository an agent session might be
# pointed at.
#
# The daemon promotes these into a named LLM profile in the state directory,
# so the key is never sent to Claude Code or Codex, and dispatch carries only
# a profile id.

AGENTRT_9ROUTER_API_KEY=
AGENTRT_9ROUTER_BASE_URL=

# Model id as the provider exposes it. Verified working against 9Router: text
# and tool calls in both streaming and non-streaming mode, with usage
# reported. Do not use the `free-model` alias: it returns text only when
# streaming and tool calls only when not, so no single mode serves an agent
# turn.
AGENTRT_DEFAULT_MODEL=ds/deepseek-v4-flash
