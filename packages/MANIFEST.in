# This MANIFEST.in file tells setuptools which files to include 
# in the sdist package distribution used for building docker image

# ==============================================================================
# Root-level workspace files
# ==============================================================================
include pyproject.toml
include uv.lock

# ==============================================================================
# agentrt-sdk
# ==============================================================================
include agentrt-sdk/pyproject.toml
recursive-include agentrt-sdk *.py
recursive-include agentrt-sdk *.j2
recursive-include agentrt-sdk py.typed

# ==============================================================================
# agentrt-tools
# ==============================================================================
include agentrt-tools/pyproject.toml
recursive-include agentrt-tools *.py
recursive-include agentrt-tools *.j2
recursive-include agentrt-tools py.typed

# ==============================================================================
# agentrt-workspace
# ==============================================================================
include agentrt-workspace/pyproject.toml
recursive-include agentrt-workspace *.py
recursive-include agentrt-workspace py.typed

# ==============================================================================
# agentrt-server
# ==============================================================================
include agentrt-server/pyproject.toml
recursive-include agentrt-server *.py
recursive-include agentrt-server py.typed

# Docker build files
include agentrt-server/openhands/agent_server/docker/Dockerfile
include agentrt-server/openhands/agent_server/docker/wallpaper.svg

# PyInstaller spec
include agentrt-server/openhands/agent_server/agent-server.spec

# VSCode extensions
recursive-include agentrt-server/openhands/agent_server/vscode_extensions *
